# Use o MESMO login que voce ja usa em https://busca.inpi.gov.br/pePI
# (cadastro gratuito em https://www.gov.br/inpi/pt-br/cadastro-no-e-inpi).
# Nunca commite o arquivo .env de verdade — ele ja esta no .gitignore.
INPI_USERNAME=seu_login_pepi
INPI_PASSWORD=sua_senha_pepi

# Opcionais — todos tem um padrao sensato, so defina se quiser mudar.
# Pasta do cache local de buscas (padrao: ~/.cache/inpi-marcas-mcp-server)
# INPI_CACHE_DIR=C:\caminho\para\cache
# Quantas horas uma busca fica valida no cache antes de expirar (padrao: 6). 0 desliga o cache.
# INPI_CACHE_TTL_HORAS=6
# Pasta onde os relatorios HTML (salvar_html=true) sao salvos (padrao: ~/inpi-marcas-mcp-server/relatorios)
# INPI_HTML_DIR=C:\caminho\para\relatorios
# Pasta onde o pacote de evidencia bruta (salvar_evidencia=true) e salvo (padrao: ~/inpi-marcas-mcp-server/evidencias)
# INPI_EVIDENCE_DIR=C:\caminho\para\evidencias
